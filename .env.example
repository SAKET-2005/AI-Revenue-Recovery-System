# ReviveAI Environment Configuration

# Application
APP_MODE=demo  # "demo" or "live"
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./reviveai.db

# LLM Configuration (optional - system works without)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Razorpay Configuration (optional - system works without)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ML Configuration
ML_MODEL_PATH=ml_artifacts/recovery_model.joblib
ML_RANDOM_SEED=42

# Recovery Policy Limits
MAX_AUTOMATED_AMOUNT=10000
AUTOMATED_RETRY_LIMIT=2
MIN_AUTO_RECOVERY_PROBABILITY=0.80
MIN_NUDGE_PROBABILITY=0.55
MIN_CONFIDENCE=0.60
MAX_ESCALATION_AMOUNT=50000
